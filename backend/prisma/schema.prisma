// Prisma schema (Prisma v7 config)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

enum VerificationType {
  CCCD
  STUDENT_CARD
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskType {
  ONLINE
  OFFLINE
  HYBRID
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AssignedBy {
  POSTER
  SYSTEM
  ADMIN
}

enum AssignedTaskStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  ESCROW_HOLD
  ESCROW_RELEASE
  REFUND
  PLATFORM_FEE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum EscrowStatus {
  HOLDING
  RELEASED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  BANK
  MOMO
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ReviewCriteriaType {
  POSITIVE
  NEGATIVE
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

// =========================
// MODELS
// =========================

model User {
  id          String     @id @default(uuid()) @db.Uuid
  firebaseUid String?    @unique @map("firebase_uid")
  fullName    String     @map("full_name")
  email       String     @unique
  phone       String?
  avatarUrl   String?    @map("avatar_url")
  status      UserStatus @default(ACTIVE)
  isVerified  Boolean    @default(false) @map("is_verified")
  createdAt   DateTime   @default(now()) @map("created_at")

  verifications         UserVerification[] @relation("UserVerifications")
  reviewedVerifications UserVerification[] @relation("ReviewedVerifications")
  taskerProfile         TaskerProfile?
  postedTasks           Task[]             @relation("TaskPoster")
  taskApplications      TaskApplication[]  @relation("TaskerApplications")
  assignedTasks         AssignedTask[]     @relation("AssignedTasker")
  wallet                Wallet?
  escrowsAsPoster       Escrow[]           @relation("EscrowPoster")
  escrowsAsTasker       Escrow[]           @relation("EscrowTasker")
  payments              Payment[]
  withdrawRequests      WithdrawRequest[]
  reviewsGiven          Review[]           @relation("Reviewer")
  reviewsReceived       Review[]           @relation("Reviewee")
  reportsMade           Report[]           @relation("Reporter")
  reportsReceived       Report[]           @relation("TargetUser")

  @@map("users")
}

model UserVerification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  type              VerificationType
  status            VerificationStatus @default(PENDING)
  ocrFullName       String?            @map("ocr_full_name")
  ocrDob            DateTime?          @map("ocr_dob") @db.Date
  ocrCccdNumberHash String?            @map("ocr_cccd_number_hash")
  reviewedBy        String?            @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at")

  user      User                   @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?                  @relation("ReviewedVerifications", fields: [reviewedBy], references: [id])
  documents VerificationDocument[]

  @@map("user_verifications")
}

model VerificationDocument {
  id             String  @id @default(uuid()) @db.Uuid
  verificationId String  @map("verification_id") @db.Uuid
  frontImageUrl  String? @map("front_image_url")
  backImageUrl   String? @map("back_image_url")
  selfieImageUrl String? @map("selfie_image_url")

  verification UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model TaskerProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  bio           String?
  experience    String?
  portfolioUrl  String?  @map("portfolio_url")
  locationText  String?  @map("location_text")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  averageRating Decimal  @default(5.00) @map("average_rating") @db.Decimal(3, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasker_profiles")
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  skills Skill[]
  tasks  Task[]

  @@map("categories")
}

model Skill {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  name       String
  slug       String @unique

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  taskRequiredSkills TaskRequiredSkill[]

  @@map("skills")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  posterId       String     @map("poster_id") @db.Uuid
  categoryId     String?    @map("category_id") @db.Uuid
  title          String
  description    String?
  taskType       TaskType   @map("task_type")
  status         TaskStatus @default(OPEN)
  budgetMin      Decimal?   @map("budget_min") @db.Decimal(12, 2)
  budgetMax      Decimal?   @map("budget_max") @db.Decimal(12, 2)
  finalPrice     Decimal?   @map("final_price") @db.Decimal(12, 2)
  deadlineStart  DateTime?  @map("deadline_start")
  deadlineEnd    DateTime?  @map("deadline_end")
  allowInsurance Boolean    @default(false) @map("allow_insurance")

  poster         User                @relation("TaskPoster", fields: [posterId], references: [id], onDelete: Cascade)
  category       Category?           @relation(fields: [categoryId], references: [id])
  requiredSkills TaskRequiredSkill[]
  locations      TaskLocation[]
  applications   TaskApplication[]
  assignedTask   AssignedTask?
  escrow         Escrow?
  reviews        Review[]
  reports        Report[]

  @@map("tasks")
}

model TaskRequiredSkill {
  id      String @id @default(uuid()) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([taskId, skillId])
  @@map("task_required_skills")
}

model TaskLocation {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  locationType String?  @map("location_type")
  address      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_locations")
}

model TaskApplication {
  id            String            @id @default(uuid()) @db.Uuid
  taskId        String            @map("task_id") @db.Uuid
  taskerId      String            @map("tasker_id") @db.Uuid
  bidPrice      Decimal?          @map("bid_price") @db.Decimal(12, 2)
  estimatedTime String?           @map("estimated_time")
  message       String?
  status        ApplicationStatus @default(PENDING)

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker       User          @relation("TaskerApplications", fields: [taskerId], references: [id], onDelete: Cascade)
  assignedTask AssignedTask?

  @@unique([taskId, taskerId])
  @@map("task_applications")
}

model AssignedTask {
  id            String             @id @default(uuid()) @db.Uuid
  taskId        String             @unique @map("task_id") @db.Uuid
  taskerId      String             @map("tasker_id") @db.Uuid
  applicationId String?            @unique @map("application_id") @db.Uuid
  assignedBy    AssignedBy         @map("assigned_by")
  status        AssignedTaskStatus @default(ACTIVE)

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker      User             @relation("AssignedTasker", fields: [taskerId], references: [id], onDelete: Cascade)
  application TaskApplication? @relation(fields: [applicationId], references: [id])

  @@map("assigned_tasks")
}

model Wallet {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @unique @map("user_id") @db.Uuid
  balance          Decimal @default(0) @db.Decimal(12, 2)
  availableBalance Decimal @default(0) @map("available_balance") @db.Decimal(12, 2)
  pendingBalance   Decimal @default(0) @map("pending_balance") @db.Decimal(12, 2)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  walletId    String                @map("wallet_id") @db.Uuid
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  status      TransactionStatus     @default(PENDING)
  referenceId String?               @map("reference_id") @db.Uuid

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Escrow {
  id                 String       @id @default(uuid()) @db.Uuid
  taskId             String       @unique @map("task_id") @db.Uuid
  posterId           String       @map("poster_id") @db.Uuid
  taskerId           String       @map("tasker_id") @db.Uuid
  amount             Decimal      @db.Decimal(12, 2)
  platformFeeAmount  Decimal      @default(0) @map("platform_fee_amount") @db.Decimal(12, 2)
  insuranceFeeAmount Decimal      @default(0) @map("insurance_fee_amount") @db.Decimal(12, 2)
  status             EscrowStatus @default(HOLDING)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  poster User @relation("EscrowPoster", fields: [posterId], references: [id])
  tasker User @relation("EscrowTasker", fields: [taskerId], references: [id])

  @@map("escrows")
}

model Payment {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @map("user_id") @db.Uuid
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model WithdrawRequest {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  amount            Decimal        @db.Decimal(12, 2)
  bankName          String         @map("bank_name")
  bankAccountNumber String         @map("bank_account_number")
  status            WithdrawStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdraw_requests")
}

model Review {
  id         String  @id @default(uuid()) @db.Uuid
  taskId     String  @map("task_id") @db.Uuid
  reviewerId String  @map("reviewer_id") @db.Uuid
  revieweeId String  @map("reviewee_id") @db.Uuid
  rating     Int
  comment    String?

  task             Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer         User                     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee         User                     @relation("Reviewee", fields: [revieweeId], references: [id])
  selectedCriteria ReviewSelectedCriteria[]

  @@map("reviews")
}

model ReviewCriteria {
  id   String             @id @default(uuid()) @db.Uuid
  name String
  type ReviewCriteriaType

  selectedCriteria ReviewSelectedCriteria[]

  @@map("review_criteria")
}

model ReviewSelectedCriteria {
  id         String @id @default(uuid()) @db.Uuid
  reviewId   String @map("review_id") @db.Uuid
  criteriaId String @map("criteria_id") @db.Uuid

  review   Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criteria ReviewCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criteriaId])
  @@map("review_selected_criteria")
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetUserId String?      @map("target_user_id") @db.Uuid
  taskId       String?      @map("task_id") @db.Uuid
  reason       String
  status       ReportStatus @default(PENDING)

  reporter   User  @relation("Reporter", fields: [reporterId], references: [id])
  targetUser User? @relation("TargetUser", fields: [targetUserId], references: [id])
  task       Task? @relation(fields: [taskId], references: [id])

  @@map("reports")
}
