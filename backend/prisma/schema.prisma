generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String             @id @default(uuid()) @db.Uuid
  firebaseUid                     String?            @unique @map("firebase_uid")
  fullName                        String             @map("full_name")
  email                           String             @unique
  phone                           String?
  avatarUrl                       String?            @map("avatar_url")
  status                          UserStatus         @default(ACTIVE)
  isVerified                      Boolean            @default(false) @map("is_verified")
  verificationToken               String?            @map("verification_token") @db.VarChar(255)
  verificationTokenExpires        DateTime?          @map("verification_token_expires")
  createdAt                       DateTime           @default(now()) @map("created_at")
  role                            String?            @default("USER") @db.VarChar(50)
  bio                             String?
  headline                        String?            @db.VarChar(255)
  skills                          Json?              @default("[]")
  cover_url                       String?
  assignedTasks                   AssignedTask[]     @relation("AssignedTasker")
  conversationsAsUser1            Conversation[]     @relation("User1Conversations")
  conversationsAsUser2            Conversation[]     @relation("User2Conversations")
  escrowsAsPoster                 Escrow[]           @relation("EscrowPoster")
  escrowsAsTasker                 Escrow[]           @relation("EscrowTasker")
  sentMessages                    Message[]          @relation("SentMessages")
  pushTokens                      PushToken[]
  payments                        Payment[]
  reportsMade                     Report[]           @relation("Reporter")
  reportsReceived                 Report[]           @relation("TargetUser")
  reviewsReceived                 Review[]           @relation("Reviewee")
  reviewsGiven                    Review[]           @relation("Reviewer")
  savedTasks                      SavedTask[]
  taskApplications                TaskApplication[]  @relation("TaskerApplications")
  taskerProfile                   TaskerProfile?
  tasks_tasks_closed_by_idTousers Task[]             @relation("tasks_closed_by_idTousers")
  postedTasks                     Task[]             @relation("TaskPoster")
  reviewedVerifications           UserVerification[] @relation("ReviewedVerifications")
  verifications                   UserVerification[] @relation("UserVerifications")
  wallet                          Wallet?
  withdrawRequests                WithdrawRequest[]
  refreshTokens                   RefreshToken[]

  @@map("users")
}

model UserVerification {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  type              VerificationType
  status            VerificationStatus     @default(PENDING)
  ocrFullName       String?                @map("ocr_full_name")
  ocrDob            DateTime?              @map("ocr_dob") @db.Date
  ocrCccdNumberHash String?                @map("ocr_cccd_number_hash")
  reviewedBy        String?                @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?              @map("reviewed_at")
  reviewer          User?                  @relation("ReviewedVerifications", fields: [reviewedBy], references: [id])
  user              User                   @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  documents         VerificationDocument[]

  @@map("user_verifications")
}

model VerificationDocument {
  id             String           @id @default(uuid()) @db.Uuid
  verificationId String           @map("verification_id") @db.Uuid
  frontImageUrl  String?          @map("front_image_url")
  backImageUrl   String?          @map("back_image_url")
  selfieImageUrl String?          @map("selfie_image_url")
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model TaskerProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  bio           String?
  experience    String?
  portfolioUrl  String?  @map("portfolio_url")
  locationText  String?  @map("location_text")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  averageRating Decimal  @default(5.00) @map("average_rating") @db.Decimal(3, 2)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasker_profiles")
}

model Category {
  id      String    @id @default(uuid()) @db.Uuid
  name    String
  slug    String    @unique
  banners banners[]
  skills  Skill[]
  tasks   Task[]

  @@map("categories")
}

model Skill {
  id                 String              @id @default(uuid()) @db.Uuid
  categoryId         String              @map("category_id") @db.Uuid
  name               String
  slug               String              @unique
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  taskRequiredSkills TaskRequiredSkill[]

  @@map("skills")
}

model Task {
  id                              String              @id @default(uuid()) @db.Uuid
  posterId                        String              @map("poster_id") @db.Uuid
  categoryId                      String?             @map("category_id") @db.Uuid
  title                           String
  description                     String?
  taskType                        TaskType            @map("task_type")
  status                          TaskStatus          @default(OPEN)
  budgetMin                       Decimal?            @map("budget_min") @db.Decimal(12, 2)
  budgetMax                       Decimal?            @map("budget_max") @db.Decimal(12, 2)
  finalPrice                      Decimal?            @map("final_price") @db.Decimal(12, 2)
  deadlineStart                   DateTime?           @map("deadline_start")
  deadlineEnd                     DateTime?           @map("deadline_end")
  allowInsurance                  Boolean             @default(false) @map("allow_insurance")
  createdAt                       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  images                          String[]            @default([])
  postType                        String              @default("RECRUITMENT") @map("post_type") @db.VarChar(20)
  workMode                        String              @default("ONSITE") @map("work_mode") @db.VarChar(20)
  salaryUnit                      String              @default("PER_JOB") @map("salary_unit") @db.VarChar(20)
  employmentType                  String              @default("ONE_TIME") @map("employment_type") @db.VarChar(20)
  peopleNeeded                    Int?                @default(1) @map("people_needed")
  contactPhone                    String?             @map("contact_phone") @db.VarChar(20)
  startDate                       DateTime?           @map("start_date") @db.Timestamp(6)
  experienceLevel                 String?             @default("NO_REQUIREMENT") @map("experience_level") @db.VarChar(50)
  educationLevel                  String?             @default("NO_REQUIREMENT") @map("education_level") @db.VarChar(50)
  genderRequirement               String?             @default("NO_REQUIREMENT") @map("gender_requirement") @db.VarChar(30)
  minAge                          Int?                @map("min_age")
  maxAge                          Int?                @map("max_age")
  minHeightCm                     Int?                @map("min_height_cm")
  maxHeightCm                     Int?                @map("max_height_cm")
  hashtags                        String[]            @default([])
  application_deadline            DateTime?           @db.Timestamp(6)
  closed_at                       DateTime?           @db.Timestamp(6)
  closed_by_id                    String?             @db.Uuid
  closed_reason                   String?
  assignedTask                    AssignedTask[]
  escrow                          Escrow?
  reports                         Report[]
  reviews                         Review[]
  savedBy                         SavedTask[]
  applications                    TaskApplication[]
  locations                       TaskLocation[]
  requiredSkills                  TaskRequiredSkill[]
  category                        Category?           @relation(fields: [categoryId], references: [id])
  users_tasks_closed_by_idTousers User?               @relation("tasks_closed_by_idTousers", fields: [closed_by_id], references: [id], onUpdate: NoAction)
  poster                          User                @relation("TaskPoster", fields: [posterId], references: [id], onDelete: Cascade)

  @@index([application_deadline], map: "idx_tasks_application_deadline")
  @@index([createdAt], map: "idx_tasks_created_at")
  @@index([postType], map: "idx_tasks_post_type")
  @@index([posterId], map: "idx_tasks_poster_id")
  @@index([workMode], map: "idx_tasks_work_mode")
  @@map("tasks")
}

model SavedTask {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId], map: "idx_saved_tasks_task_id")
  @@index([userId, createdAt], map: "idx_saved_tasks_user_created_at")
  @@map("saved_tasks")
}

model TaskRequiredSkill {
  id      String @id @default(uuid()) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, skillId])
  @@map("task_required_skills")
}

model TaskLocation {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  locationType String?  @map("location_type")
  address      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_locations")
}

model TaskApplication {
  id            String            @id @default(uuid()) @db.Uuid
  taskId        String            @map("task_id") @db.Uuid
  taskerId      String            @map("tasker_id") @db.Uuid
  bidPrice      Decimal?          @map("bid_price") @db.Decimal(12, 2)
  estimatedTime String?           @map("estimated_time")
  message       String?
  status        ApplicationStatus @default(PENDING)
  assignedTask  AssignedTask?
  task          Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker        User              @relation("TaskerApplications", fields: [taskerId], references: [id], onDelete: Cascade)

  @@unique([taskId, taskerId])
  @@unique([taskId, taskerId], map: "unique_task_tasker")
  @@index([taskId], map: "idx_task_applications_task_id")
  @@index([taskerId], map: "idx_task_applications_tasker_id")
  @@map("task_applications")
}

model AssignedTask {
  id            String             @id @default(uuid()) @db.Uuid
  taskId        String             @map("task_id") @db.Uuid
  taskerId      String             @map("tasker_id") @db.Uuid
  applicationId String?            @unique @map("application_id") @db.Uuid
  assignedBy    AssignedBy         @map("assigned_by")
  status        AssignedTaskStatus @default(ACTIVE)
  application   TaskApplication?   @relation(fields: [applicationId], references: [id])
  task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker        User               @relation("AssignedTasker", fields: [taskerId], references: [id], onDelete: Cascade)

  @@unique([taskId, taskerId], map: "idx_assigned_tasks_task_tasker")
  @@map("assigned_tasks")
}

model Wallet {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @unique @map("user_id") @db.Uuid
  balance          Decimal             @default(0) @db.Decimal(12, 2)
  availableBalance Decimal             @default(0) @map("available_balance") @db.Decimal(12, 2)
  lockedBalance    Decimal             @default(0) @map("locked_balance") @db.Decimal(12, 2)
  transactions     WalletTransaction[]
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  walletId    String                @map("wallet_id") @db.Uuid
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  status      TransactionStatus     @default(PENDING)
  referenceId String?               @map("reference_id") @db.Uuid
  order_code  BigInt?               @unique
  created_at  DateTime              @default(now()) @db.Timestamp(6)
  wallet      Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Escrow {
  id                 String       @id @default(uuid()) @db.Uuid
  taskId             String       @unique @map("task_id") @db.Uuid
  posterId           String       @map("poster_id") @db.Uuid
  taskerId           String       @map("tasker_id") @db.Uuid
  amount             Decimal      @db.Decimal(12, 2)
  platformFeeAmount  Decimal      @default(0) @map("platform_fee_amount") @db.Decimal(12, 2)
  insuranceFeeAmount Decimal      @default(0) @map("insurance_fee_amount") @db.Decimal(12, 2)
  status             EscrowStatus @default(HOLDING)
  poster             User         @relation("EscrowPoster", fields: [posterId], references: [id])
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker             User         @relation("EscrowTasker", fields: [taskerId], references: [id])

  @@map("escrows")
}

model Payment {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @map("user_id") @db.Uuid
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model WithdrawRequest {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  amount            Decimal        @db.Decimal(12, 2)
  bankName          String         @map("bank_name")
  bankAccountNumber String         @map("bank_account_number")
  status            WithdrawStatus @default(PENDING)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdraw_requests")
}

model Review {
  id               String                   @id @default(uuid()) @db.Uuid
  taskId           String                   @map("task_id") @db.Uuid
  reviewerId       String                   @map("reviewer_id") @db.Uuid
  revieweeId       String                   @map("reviewee_id") @db.Uuid
  rating           Int
  comment          String?
  selectedCriteria ReviewSelectedCriteria[]
  reviewee         User                     @relation("Reviewee", fields: [revieweeId], references: [id])
  reviewer         User                     @relation("Reviewer", fields: [reviewerId], references: [id])
  task             Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model ReviewCriteria {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  type             ReviewCriteriaType
  selectedCriteria ReviewSelectedCriteria[]

  @@map("review_criteria")
}

model ReviewSelectedCriteria {
  id         String         @id @default(uuid()) @db.Uuid
  reviewId   String         @map("review_id") @db.Uuid
  criteriaId String         @map("criteria_id") @db.Uuid
  criteria   ReviewCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  review     Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criteriaId])
  @@map("review_selected_criteria")
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetUserId String?      @map("target_user_id") @db.Uuid
  taskId       String?      @map("task_id") @db.Uuid
  reason       String
  status       ReportStatus @default(PENDING)
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
  targetUser   User?        @relation("TargetUser", fields: [targetUserId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])

  @@map("reports")
}

model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  user1Id         String    @map("user1_id") @db.Uuid
  user2Id         String    @map("user2_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user1LastReadAt DateTime? @map("user1_last_read_at")
  user2LastReadAt DateTime? @map("user2_last_read_at")
  user1           User      @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User      @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  text           String?
  type           String       @default("TEXT") @db.VarChar(20)
  imageUrl       String?      @map("image_url")
  status         String       @default("SENT") @db.VarChar(20)
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "idx_messages_conversation_id")
  @@index([senderId], map: "idx_messages_sender_id")
  @@map("messages")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_push_tokens_user_id")
  @@map("push_tokens")
}

model banners {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @unique @db.VarChar(255)
  title         String    @db.VarChar(255)
  subtitle      String?
  image_url     String
  category_id   String    @db.Uuid
  placement     String    @db.VarChar(255)
  action_type   String    @db.VarChar(255)
  action_value  String?
  display_order Int
  is_active     Boolean   @default(true)
  start_at      DateTime? @db.Timestamp(6)
  end_at        DateTime? @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  categories    Category  @relation(fields: [category_id], references: [id], onUpdate: NoAction)

  @@index([display_order], map: "idx_banners_display_order")
  @@index([end_at], map: "idx_banners_end_at")
  @@index([is_active], map: "idx_banners_is_active")
  @@index([placement], map: "idx_banners_placement")
  @@index([placement, is_active, display_order], map: "idx_banners_placement_active_order")
  @@index([start_at], map: "idx_banners_start_at")
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

enum VerificationType {
  CCCD
  STUDENT_CARD
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskType {
  ONLINE
  OFFLINE
  HYBRID
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AssignedBy {
  POSTER
  SYSTEM
  ADMIN
}

enum AssignedTaskStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ASSIGNED
  IN_PROGRESS
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  ESCROW_HOLD
  ESCROW_RELEASE
  REFUND
  PLATFORM_FEE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum EscrowStatus {
  HOLDING
  RELEASED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  BANK
  MOMO
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ReviewCriteriaType {
  POSITIVE
  NEGATIVE
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  userId     String   @map("user_id") @db.Uuid
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

