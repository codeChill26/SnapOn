# App
PORT=3000

# Supabase Postgres
# Prefer copying the full connection string from Supabase.
# Make sure SSL is enabled (sslmode=require).
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.zxhcqjrfwbxwuvlxhleq.supabase.co:5432/postgres?sslmode=require

# Prisma CLI (db pull / migrate) is most reliable with a direct (non-pooler) connection.
# If your DATABASE_URL uses Supabase Pooler/pgbouncer, set this to the direct connection string.
DIRECT_URL=postgresql://postgres:<YOUR_PASSWORD>@db.zxhcqjrfwbxwuvlxhleq.supabase.co:5432/postgres?sslmode=require

# Alternative name (also supported by this repo):
DIRECT_DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.zxhcqjrfwbxwuvlxhleq.supabase.co:5432/postgres?sslmode=require

# Optional (pg defaults to SSL when sslmode=require in the URL)
PGSSLMODE=require
