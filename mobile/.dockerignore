# Dependencies & build artifacts
node_modules/
npm-debug.log*

# Native generated folders (will be regenerated by expo prebuild)
android/
ios/

# Expo cache
.expo/

# Build outputs (don't include old builds in Docker context)
*.aab
*.apk
*.ipa

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation (not needed for build)
BUILD_GUIDE.md
DOCKER_BUILD_GUIDE.md
README.md

# Keystore directory (mounted separately for security)
keystores/

# Environment files
.env
.env.local
